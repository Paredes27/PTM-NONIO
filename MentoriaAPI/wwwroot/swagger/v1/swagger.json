    "/api/sessions/{id}/status": { "put": { "summary": "Atualizar estado da sessão", "responses": { "200": { "description": "OK" } } } },
    "/api/feedback": { "get": { "summary": "Listar feedback", "responses": { "200": { "description": "OK" } } }, "post": { "summary": "Criar feedback", "responses": { "200": { "description": "OK" } } } }
