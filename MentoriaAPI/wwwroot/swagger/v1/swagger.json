    "/api/auth/register": { "post": { "summary": "Registar utilizador", "responses": { "200": { "description": "OK" } } } },
    "/api/users": { "get": { "summary": "Listar utilizadores", "responses": { "200": { "description": "OK" } } } },
    "/api/students": { "get": { "summary": "Listar alunos", "responses": { "200": { "description": "OK" } } } },
    "/api/mentors": { "get": { "summary": "Listar mentores", "responses": { "200": { "description": "OK" } } } },
    "/api/tutors": { "get": { "summary": "Listar tutores", "responses": { "200": { "description": "OK" } } } },
    "/api/matches": { "get": { "summary": "Listar matches", "responses": { "200": { "description": "OK" } } }, "post": { "summary": "Criar match", "responses": { "200": { "description": "OK" } } } },
